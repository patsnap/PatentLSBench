{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patent-ocsr-page-v1.0.0",
  "title": "Patent Page Chemical Structure Detection and Recognition Benchmark",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "id",
    "patent_no",
    "page_no",
    "pdf_path",
    "preview_image",
    "coordinate_reference_size",
    "layout_count",
    "ocsr_count",
    "layout_gt",
    "ocsr_gt"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "patent_no": {
      "type": "string"
    },
    "page_no": {
      "type": "integer"
    },
    "pdf_path": {
      "type": "string"
    },
    "preview_image": {
      "type": "string"
    },
    "coordinate_reference_size": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "layout_count": {
      "type": "integer",
      "minimum": 1
    },
    "ocsr_count": {
      "type": "integer",
      "minimum": 0
    },
    "layout_gt": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "region_id",
          "bbox",
          "image",
          "labels"
        ],
        "properties": {
          "region_id": {
            "type": "string"
          },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "image": {
            "type": "string"
          },
          "labels": {
            "type": "object",
            "required": [
              "type",
              "chemical_family",
              "component_features",
              "atom_bond_features",
              "stereo_features",
              "notation_features",
              "topology_features",
              "scene",
              "image_defects"
            ],
            "properties": {
              "type": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string",
                  "enum": [
                    "完整结构",
                    "取代基结构",
                    "马库什结构",
                    "不定型结构"
                  ]
                },
                "uniqueItems": true,
                "description": "该结构图表达的具体性、开放连接及泛化形式；分类依据图示化学语义。"
              },
              "chemical_family": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string",
                  "enum": [
                    "常规有机结构",
                    "肽/蛋白结构",
                    "核酸/核苷(酸)类结构",
                    "糖类结构",
                    "聚合/重复结构",
                    "生物偶联结构",
                    "配位/有机金属结构",
                    "无机结构",
                    "其他化学结构"
                  ]
                },
                "uniqueItems": true,
                "description": "图中化学对象所属的化学类别；可组合描述同一对象中明确存在的家族特征。"
              },
              "component_features": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string",
                  "enum": [
                    "盐/离子对",
                    "水合物",
                    "其他溶剂化物",
                    "共晶",
                    "明确混合物"
                  ]
                },
                "uniqueItems": true,
                "description": "该化学对象的离子、溶剂、共晶、混合及计量等组分特征。"
              },
              "atom_bond_features": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string",
                  "enum": [
                    "同位素",
                    "显式电荷",
                    "配位键",
                    "多中心键",
                    "芳香圆圈/离域表达",
                    "单独画出的氢",
                    "查询/不确定键"
                  ]
                },
                "uniqueItems": true,
                "description": "图中明确表达的同位素、电荷、自由基、键类型及其他原子/键特征。"
              },
              "stereo_features": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string",
                  "enum": [
                    "楔线/虚楔线",
                    "双键几何表达",
                    "文字构型标识",
                    "相对立体表达",
                    "明确未知立体表达",
                    "外消旋/立体混合物",
                    "轴手性/阻转异构",
                    "平面/螺旋手性",
                    "透视环画法",
                    "其他立体表达"
                  ]
                },
                "uniqueItems": true,
                "description": "图中实际指定的立体信息及其表达方式。"
              },
              "notation_features": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string",
                  "enum": [
                    "固定缩写",
                    "变量原子/基团标签",
                    "开放连接点",
                    "可变连接位置",
                    "不定环",
                    "重复括号",
                    "固定重复次数",
                    "可变重复次数/范围",
                    "序列缩写",
                    "生物大分子占位表述",
                    "其他特殊表述"
                  ]
                },
                "uniqueItems": true,
                "description": "图中固定缩写、变量、连接点、重复单元、序列和占位表述。"
              },
              "topology_features": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string",
                  "enum": [
                    "大环",
                    "稠环",
                    "螺环",
                    "桥环",
                    "笼状结构"
                  ]
                },
                "uniqueItems": true,
                "description": "该结构可确认的环连接形式。"
              },
              "scene": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string",
                  "enum": [
                    "独立图示",
                    "反应图内",
                    "结构表格内",
                    "多结构图组内",
                    "正文内嵌",
                    "其他场景"
                  ]
                },
                "uniqueItems": true,
                "description": "该结构在来源图页中的版式环境；与结构对象绑定。"
              },
              "image_defects": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string",
                  "enum": [
                    "低分辨率",
                    "模糊",
                    "低对比度",
                    "噪声/压缩伪影",
                    "断线",
                    "粘连",
                    "遮挡/局部缺损",
                    "文字干扰",
                    "表格线/箭头干扰",
                    "倾斜/扫描变形",
                    "其他图像问题"
                  ]
                },
                "uniqueItems": true,
                "description": "该结构实际输入图像中可确认的成像、扫描和排版缺陷。"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "ocsr_gt": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "region_id",
          "molfile",
          "smiles",
          "inchikey"
        ],
        "additionalProperties": false,
        "properties": {
          "region_id": {
            "type": "string"
          },
          "molfile": {
            "type": "string"
          },
          "smiles": {
            "type": [
              "string",
              "null"
            ]
          },
          "inchikey": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "x-files": {
    "pages.jsonl": "one page object per line; the primary model-input/GT table",
    "regions.jsonl": "one chemical region per row, linked to its page by page_id",
    "ocsr.jsonl": "page_id plus region_id/molfile/smiles/inchikey; flattened OCSR GT",
    "attachments.manifest.jsonl": "page_id in record_id; all page and child asset paths are package-relative"
  },
  "x-coordinates": {
    "bbox_order": [
      "x1",
      "y1",
      "x2",
      "y2"
    ],
    "origin": "top-left",
    "normalized": true,
    "reference": "coordinate_reference_size from the supplied annotation raster",
    "preview_image": "display only; rendering does not redefine or alter bbox"
  },
  "x-preview-render": {
    "renderer": "PyMuPDF",
    "dpi": 120,
    "colorspace": "RGB",
    "alpha": false,
    "annots": true,
    "jpeg_quality": 88,
    "page_index": 0,
    "long_edge_cap": 3000,
    "rotation_policy": "render existing PDF Rotate; preserve bbox unchanged",
    "purpose": "preview only; supplied single-page raster PDF is model input",
    "per_asset_metadata": "attachments.manifest.jsonl includes width, height, requested_dpi, effective_dpi and long_edge_cap for each preview",
    "scale_policy": "render directly at min(requested DPI, scale needed for long-edge cap); preserve supplied PDF and bbox"
  },
  "x-labels": {
    "null": "unavailable/unknown for that dimension",
    "empty_array": "assessed; no current-dictionary feature selected",
    "dimensions": [
      {
        "field": "type",
        "name": "结构类型",
        "definition": "该结构图表达的具体性、开放连接及泛化形式；分类依据图示化学语义。",
        "multi_select": true,
        "minimum_values": 1,
        "values": [
          "完整结构",
          "取代基结构",
          "马库什结构",
          "不定型结构"
        ]
      },
      {
        "field": "chemical_family",
        "name": "化学家族",
        "definition": "图中化学对象所属的化学类别；可组合描述同一对象中明确存在的家族特征。",
        "multi_select": true,
        "minimum_values": 1,
        "values": [
          "常规有机结构",
          "肽/蛋白结构",
          "核酸/核苷(酸)类结构",
          "糖类结构",
          "聚合/重复结构",
          "生物偶联结构",
          "配位/有机金属结构",
          "无机结构",
          "其他化学结构"
        ]
      },
      {
        "field": "component_features",
        "name": "组分形式",
        "definition": "该化学对象的离子、溶剂、共晶、混合及计量等组分特征。",
        "multi_select": true,
        "minimum_values": 0,
        "values": [
          "盐/离子对",
          "水合物",
          "其他溶剂化物",
          "共晶",
          "明确混合物"
        ]
      },
      {
        "field": "atom_bond_features",
        "name": "原子与键特征",
        "definition": "图中明确表达的同位素、电荷、自由基、键类型及其他原子/键特征。",
        "multi_select": true,
        "minimum_values": 0,
        "values": [
          "同位素",
          "显式电荷",
          "配位键",
          "多中心键",
          "芳香圆圈/离域表达",
          "单独画出的氢",
          "查询/不确定键"
        ]
      },
      {
        "field": "stereo_features",
        "name": "立体表达",
        "definition": "图中实际指定的立体信息及其表达方式。",
        "multi_select": true,
        "minimum_values": 0,
        "values": [
          "楔线/虚楔线",
          "双键几何表达",
          "文字构型标识",
          "相对立体表达",
          "明确未知立体表达",
          "外消旋/立体混合物",
          "轴手性/阻转异构",
          "平面/螺旋手性",
          "透视环画法",
          "其他立体表达"
        ]
      },
      {
        "field": "notation_features",
        "name": "缩写与泛化表达",
        "definition": "图中固定缩写、变量、连接点、重复单元、序列和占位表述。",
        "multi_select": true,
        "minimum_values": 0,
        "values": [
          "固定缩写",
          "变量原子/基团标签",
          "开放连接点",
          "可变连接位置",
          "不定环",
          "重复括号",
          "固定重复次数",
          "可变重复次数/范围",
          "序列缩写",
          "生物大分子占位表述",
          "其他特殊表述"
        ]
      },
      {
        "field": "topology_features",
        "name": "环拓扑",
        "definition": "该结构可确认的环连接形式。",
        "multi_select": true,
        "minimum_values": 0,
        "values": [
          "大环",
          "稠环",
          "螺环",
          "桥环",
          "笼状结构"
        ]
      },
      {
        "field": "scene",
        "name": "所在版式场景",
        "definition": "该结构在来源图页中的版式环境；与结构对象绑定。",
        "multi_select": true,
        "minimum_values": 1,
        "values": [
          "独立图示",
          "反应图内",
          "结构表格内",
          "多结构图组内",
          "正文内嵌",
          "其他场景"
        ]
      },
      {
        "field": "image_defects",
        "name": "图像问题",
        "definition": "该结构实际输入图像中可确认的成像、扫描和排版缺陷。",
        "multi_select": true,
        "minimum_values": 0,
        "values": [
          "低分辨率",
          "模糊",
          "低对比度",
          "噪声/压缩伪影",
          "断线",
          "粘连",
          "遮挡/局部缺损",
          "文字干扰",
          "表格线/箭头干扰",
          "倾斜/扫描变形",
          "其他图像问题"
        ]
      }
    ]
  },
  "x-ocsr": {
    "molfile": "original reference bytes",
    "smiles": "derived from original reference MOL; may be null if unsupported",
    "inchikey": "derived from original reference MOL; may be null if unsupported; follow MOLECULAR_GT_PROTOCOL.md",
    "inchikey_match_denominator": "non-null, validated InChIKey references",
    "mol_reference_count": "independent coverage count; a preserved MOL does not guarantee a supported standard identifier",
    "smiles_match_denominator": "non-null, validated canonical SMILES references"
  }
}
